{
  "buildCommand": "node scripts/write-config.js",
  "outputDirectory": ".",
  "headers": [
    {
      "source": "/(assets|ASSET)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/home.html"
    }
  ]
}
